diff --git a/internal/gateway/search_service.go b/internal/gateway/search_service.go
new file mode 100644
index 00000000..4709c03a
--- /dev/null
+++ b/internal/gateway/search_service.go
@@ -0,0 +1,77 @@
+package gateway
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"time"
+
+	"github.com/yetone/magpie/internal/access"
+	"github.com/yetone/magpie/internal/budget"
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/usage"
+)
+
+// A keyed service searches the web with a provider's own key rather than
+// through a model: no model request is made and no model list is read. It
+// appears in the searcher list as a service choice, is named in Settings
+// with no model, passes the spent check, searches when asked, and is never
+// picked by itself — only named. Where a provider is on one is decided
+// here alone: a new keyed service joins serviceSearchers, and the sites
+// that treat one specially ask the seam (search_kimi.go holds the Kimi
+// Code plan).
+
+// serviceSearcher is a keyed service: where a provider on it searches,
+// and how the service is asked.
+type serviceSearcher struct {
+	url    func(provider.Provider) string
+	search func(*Server, context.Context, provider.Provider, string) (string, []Hit, error)
+}
+
+// serviceSearchers are the keyed services. A Kimi Code plan's search
+// service, a DeepSeek provider's tools API and a Remote magpie's web_search
+// are the three.
+var serviceSearchers = []serviceSearcher{
+	{url: provider.KimiCodeSearch, search: (*Server).kimiSearch},
+	{url: DeepSeekSearch, search: (*Server).deepSeekSearch},
+	{url: remoteMagpieService, search: (*Server).remoteMagpieSearch},
+}
+
+// serviceSearch is where p searches through its keyed service rather than
+// a model: that service's endpoint, "" when p searches through a model.
+func serviceSearch(p provider.Provider) string {
+	for _, svc := range serviceSearchers {
+		if u := svc.url(p); u != "" {
+			return u
+		}
+	}
+	return ""
+}
+
+// serviceSearchBy asks p's keyed service (serviceSearch) to search.
+func (s *Server) serviceSearchBy(ctx context.Context, p provider.Provider, query string) (string, []Hit, error) {
+	for _, svc := range serviceSearchers {
+		if svc.url(p) != "" {
+			return svc.search(s, ctx, p, query)
+		}
+	}
+	return "", nil, fmt.Errorf("%s: no search service", p.Name)
+}
+
+// recordServiceSearch records the call a keyed service made: one row for
+// the caller's key, the provider and the key used, no tokens, kind the
+// service's — web_search_api for a search, web_fetch for a fetch
+// pass-through — and the service's price on OwnCost, nil for a pass-through,
+// which costs nothing here, the remote's own row carrying its spend. A
+// failure or an empty result never gets here.
+func (s *Server) recordServiceSearch(ctx context.Context, p provider.Provider, key, kind string, cost *float64) {
+	rec := usage.Record{Time: time.Now(), Kind: kind, Provider: p.ID, Host: p.Where(),
+		ProviderKeyID: provider.KeyID(key), ProviderKeyName: p.KeyName, Status: http.StatusOK, OwnCost: cost}
+	if f := searchFor(ctx); f != nil {
+		rec.Agent = f.Agent
+	}
+	if who := access.Caller(ctx); who.KeyID != "" {
+		rec.CallerKeyID, rec.CallerKeyName = who.KeyID, who.KeyName
+	}
+	budget.Append(rec)
+}
diff --git a/internal/gateway/search_service_test.go b/internal/gateway/search_service_test.go
new file mode 100644
index 00000000..5efd06a5
--- /dev/null
+++ b/internal/gateway/search_service_test.go
@@ -0,0 +1,101 @@
+package gateway
+
+import (
+	"context"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// The service-searcher seam: one answer, at every place that treats one
+// specially, to whether a provider searches through its own keyed service
+// rather than a model. The Kimi Code plan is one of the services; a
+// provider on it is a service choice with no model, is named with no
+// model, passes the spent check, searches by its service when asked, and
+// is named only by hand. A plain keyed provider does none of that.
+func TestServiceSearcherSeam(t *testing.T) {
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	setHome(t, t.TempDir()) // no signed-in agent searches
+	kimi := newKimiPlan(t)
+	if err := provider.Save(provider.Provider{ID: "kimi", Name: "Kimi Code", Preset: "kimi-code-cn", Key: "sk-kimi",
+		Chat: kimi.URL + "/coding/v1", Models: []string{"kimi-for-coding"}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := provider.Save(provider.Provider{ID: "oai", Name: "OpenAI", Key: "sk-oai",
+		Chat: "http://127.0.0.1:9/v1", Models: []string{"gpt-5-mini"}}); err != nil {
+		t.Fatal(err)
+	}
+	of := func(id string) provider.Provider {
+		i := slices.IndexFunc(provider.All(), func(p provider.Provider) bool { return p.ID == id })
+		if i < 0 {
+			t.Fatalf("no %s saved", id)
+		}
+		return provider.All()[i]
+	}
+	kimiP, oaiP := of("kimi"), of("oai")
+
+	// the searcher list offers the plan as a service choice, with no model
+	cs := Searchers()
+	if len(cs) != 1 || cs[0].Provider.ID != "kimi" || !cs[0].Service || !cs[0].ManualOnly || cs[0].Small != "" || len(cs[0].Models) != 0 {
+		t.Fatalf("choices %+v", cs)
+	}
+
+	// named in Settings, it searches with no model
+	st := settings.Load()
+	st.Searcher = "kimi"
+	if err := settings.Save(st); err != nil {
+		t.Fatal(err)
+	}
+	cp, model, why := chosenSearcher()
+	if cp == nil || cp.ID != "kimi" || model != "" || why != "" {
+		t.Fatalf("named %v %q %q", cp, model, why)
+	}
+
+	// the spent check passes it whatever model is named, while a plain
+	// provider's key out of its allowance is held
+	restingUntil.Lock()
+	for _, id := range []string{"kimi", "oai"} {
+		restingUntil.m[id] = time.Now().Add(time.Hour)
+		restingUntil.note[id] = Rest{Why: failQuota}
+	}
+	restingUntil.Unlock()
+	t.Cleanup(func() {
+		restingUntil.Lock()
+		defer restingUntil.Unlock()
+		for _, id := range []string{"kimi", "oai"} {
+			delete(restingUntil.m, id)
+			delete(restingUntil.note, id)
+		}
+	})
+	if err := searcherSpent(kimiP, "kimi-for-coding"); err != nil {
+		t.Fatalf("the service held: %v", err)
+	}
+	if searcherSpent(kimiP, "") != nil {
+		t.Fatal("the service held with no model")
+	}
+	if searcherSpent(oaiP, "gpt-5-mini") == nil {
+		t.Fatal("a spent key not held")
+	}
+
+	// asked to search, it asks its service, not a model
+	said, hits, err := New().searchBy(context.Background(), kimiP, "", "latest go", "")
+	if err != nil || len(hits) != 1 || hits[0].URL != "https://go.dev/dl/" || !strings.Contains(said, "go1.27.1") {
+		t.Fatalf("%q %+v %v", said, hits, err)
+	}
+	if len(kimi.searched) != 1 || !strings.HasPrefix(kimi.searched[0], "latest go | ") {
+		t.Fatalf("searched %q", kimi.searched)
+	}
+
+	// and it comes last, named only by hand
+	if r, manual := namedSearcherRank(kimiP); r != manualRelayRank || !manual {
+		t.Fatalf("rank %d, manual %v", r, manual)
+	}
+	if r, manual := namedSearcherRank(oaiP); r != -1 || manual {
+		t.Fatalf("a plain provider's rank %d, manual %v", r, manual)
+	}
+}
