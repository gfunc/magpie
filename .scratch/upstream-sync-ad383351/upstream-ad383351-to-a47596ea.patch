+	"log"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/yetone/magpie/internal/edit"
+	"github.com/yetone/magpie/internal/gateway"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// The app serves its window's page to a browser too, when Settings ›
+// Network and sharing › Browser access says so (jiakun_zhao on X: the page
+// managed through a Cloudflare tunnel took `magpie web` kept running in a
+// terminal beside the app). It is magpie web's page, served from the app's
+// own process, beside the gateway the app serves: the same key in the
+// link, traded for the same cookie (webGuard), the same allow list, and
+// the gateway's client routes on its port judged as from another machine
+// (onePort). There is no way to serve it without the key.
+//
+// "local" listens on 127.0.0.1 alone, for a tunnel or an SSH forward to
+// reach (cloudflared's service is http://127.0.0.1:<port>); "lan" on every
+// address, for other computers on the network. Its port and key live in
+// web-page.json beside settings.json, this computer's alone, never in
+// settings.json: a sync or a backup never carries the key to another
+// computer, nor turns the page on there.
+
+// appPageFile is where the app's page's choice and key are kept, 0600.
+func appPageFile() string { return filepath.Join(settings.Dir(), "web-page.json") }
+
+// appPageDefaultPort is magpie web's own port: a browser signed in to one
+// is signed in to the other where they share the key.
+const appPageDefaultPort = 3430
+
+// appPageConf is web-page.json: Mode "" (off), "local" or "lan"; Port 0
+// for appPageDefaultPort; Key the link's.
+type appPageConf struct {
+	Mode string `json:"mode,omitempty"`
+	Port int    `json:"port,omitempty"`
+	Key  string `json:"key,omitempty"`
+}
+
+func (c appPageConf) port() int {
+	if c.Port == 0 {
+		return appPageDefaultPort
+	}
+	return c.Port
+}
+
+// addr is where the page listens, "" when it is off.
+func (c appPageConf) addr() string {
+	switch c.Mode {
+	case "local":
+		return net.JoinHostPort("127.0.0.1", strconv.Itoa(c.port()))
+	case "lan":
+		return net.JoinHostPort("0.0.0.0", strconv.Itoa(c.port()))
+	}
+	return ""
+}
+
+// loadAppPage reads web-page.json. A file that can't be read or parsed is
+// off, and says why: nothing is served on a choice not known.
+func loadAppPage() (appPageConf, error) {
+	var c appPageConf
+	b, err := os.ReadFile(appPageFile())
+	if errors.Is(err, os.ErrNotExist) {
+		return c, nil
+	}
+	if err != nil {
+		return appPageConf{}, err
+	}
+	if err := json.Unmarshal(b, &c); err != nil {
+		return appPageConf{}, fmt.Errorf("%s: %w", appPageFile(), err)
+	}
+	if c.Mode != "" && c.Mode != "local" && c.Mode != "lan" {
+		return appPageConf{}, fmt.Errorf("%s: mode is local, lan or off, not %q", appPageFile(), c.Mode)
+	}
+	return c, nil
+}
+
+// saveAppPage writes web-page.json readable by its owner alone: it holds
+// the key that opens every setting and key magpie has.
+func saveAppPage(c appPageConf) error {
+	p := appPageFile()
+	if err := os.MkdirAll(filepath.Dir(p), 0o700); err != nil {
+		return err
+	}
+	// made 0600 before anything is in it, so WriteAtomic keeps that mode
+	if f, err := os.OpenFile(p, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600); err == nil {
+		f.Close()
+	}
+	b, _ := json.MarshalIndent(c, "", "  ")
+	if err := edit.WriteAtomic(p, append(b, '\n')); err != nil {
+		return err
+	}
+	return os.Chmod(p, 0o600)
+}
+
+// AppPage is where the app serves its page and its key, "" when it doesn't
+// say it does: `magpie web` points to it rather than starting a second.
+func AppPage() (addr, key string) {
+	c, err := loadAppPage()
+	if err != nil || c.addr() == "" || CheckWebKey(c.Key) != nil {
+		return "", ""
+	}
+	return c.addr(), c.Key
+}
+
+// appWebHost is the Windows a browser on the app's page stands for: a
+// browser's (webHost's) in all but quitting, which quits the app, and the
+// window the app has up, which a restart to update brings back.
+type appWebHost struct {
+	webHost
+	app Windows
+}
+
+func (a appWebHost) MainShown() bool { return mainShown(a.app) }
+
+// appPage is the app's page served to a browser: listening where
+// web-page.json says, or trying again every appPageRetry while another
+// program (magpie web, the magpie before a restart to update) has the port.
+type appPage struct {
+	mu   sync.Mutex
+	mk   func() http.Handler // the page behind the key; nil until the app starts
+	page http.Handler
+	srv  *http.Server
+	addr string                       // where it listens, "" when it doesn't
+	cur  atomic.Pointer[http.Handler] // webServed with the key now
+	key  string
+	err  string // why it isn't served where asked
+	wake chan struct{}
+}
+
+var appPageServer = &appPage{wake: make(chan struct{}, 1)}
+
+// appPageRetry is how often a busy port is tried again.
+var appPageRetry = 4 * time.Second
+
+// startAppPage has the app serve its page as web-page.json says, now and
+// whenever Settings changes it. app is the app's own windows; gw the
+// gateway it serves (nil while another magpie has it).
+func startAppPage(app Windows, gw *gateway.Server) {
+	p := appPageServer
+	p.mu.Lock()
+	p.mk = func() http.Handler { return Handler(appWebHost{webHost{quit: app.Quit}, app}, gw) }
+	p.mu.Unlock()
+	go p.run()
+}
+
+func (p *appPage) run() {
+	for {
+		p.apply()
+		var retry <-chan time.Time
+		if p.waiting() {
+			retry = time.After(appPageRetry)
+		}
+		select {
+		case <-p.wake:
+		case <-retry:
+		}
+	}
+}
+
+// nudge has the loop look again, so a port found busy now is tried again.
+func (p *appPage) nudge() {
+	select {
+	case p.wake <- struct{}{}:
+	default:
+	}
+}
+
+// waiting: the page is asked for and not served.
+func (p *appPage) waiting() bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.err != "" && p.mk != nil
+}
+
+// apply brings what is served to what web-page.json says.
+func (p *appPage) apply() {
+	c, err := loadAppPage()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.mk == nil {
+		return
+	}
+	want := c.addr()
+	if err != nil {
+		want, p.err = "", err.Error()
+	}
+	if p.srv != nil && p.addr != want {
+		p.srv.Close()
+		p.srv, p.addr = nil, ""
+	}
+	if want == "" {
+		if err == nil {
+			p.err = ""
+		}
+		return
+	}
+	if CheckWebKey(c.Key) != nil {
+		p.err = "the page has no key yet"
+		return
+	}
+	if p.page == nil {
+		p.page = p.mk()
+	}
+	if p.key != c.Key || p.cur.Load() == nil {
+		h := webServed(strconv.Itoa(c.port()), c.Key, webCookieAge, p.page)
+		p.cur.Store(&h)
+		p.key = c.Key
+	}
+	if p.srv != nil {
+		return
+	}
+	ln, err := net.Listen("tcp", want)
+	if err != nil {
+		p.err = busySays(c.port(), err)
+		return
+	}
+	// with --tls-cert the page is HTTPS to other computers, as magpie web's
+	if ln, err = gateway.ServeTLS(ln); err != nil {
+		p.err = err.Error()
+		return
+	}
+	p.srv = &http.Server{
+		Handler:           http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) { (*p.cur.Load()).ServeHTTP(rw, r) }),
+		ReadHeaderTimeout: 30 * time.Second,
+	}
+	p.addr, p.err = want, ""
+	go p.srv.Serve(ln)
+	log.Printf("magpie: the page is served to browsers on %s", ln.Addr())
+}
+
+// busySays is why the page couldn't listen on port: most often another
+// program has it (magpie web, or the magpie before a restart to update).
+func busySays(port int, err error) string {
+	return fmt.Sprintf("port %d can't be taken (%v): magpie tries again every few seconds", port, err)
+}
+
+// appPageJSON is GET /api/web-page: the choice, and what came of it.
+type appPageJSON struct {
+	Mode    string   `json:"mode"`
+	Port    int      `json:"port"`
+	Serving bool     `json:"serving"`
+	Link    string   `json:"link,omitempty"`    // this computer's, with the key
+	Network []string `json:"network,omitempty"` // other computers', with the key ("lan")
+	Error   string   `json:"error,omitempty"`
+	// TLS: other computers get it over HTTPS (--tls-cert)
+	TLS bool `json:"tls,omitempty"`
+}
+
+func (p *appPage) state() appPageJSON {
+	c, err := loadAppPage()
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	s := appPageJSON{Mode: c.Mode, Port: c.port(), Serving: p.srv != nil && p.addr == c.addr(), Error: p.err, TLS: gateway.TLSOn()}
+	if err != nil {
+		s.Error = err.Error()
+	}
+	if c.Mode == "" || CheckWebKey(c.Key) != nil {
+		return s
+	}
+	k := "/?k=" + url.QueryEscape(c.Key)
+	s.Link = "http://" + net.JoinHostPort("127.0.0.1", strconv.Itoa(c.port())) + k
+	if c.Mode == "lan" {
+		s.Network = NetworkLinks(strconv.Itoa(c.port()), k)
+	}
+	return s
+}
+
+// appPageRoutes: GET /api/web-page says what is served; POST takes
+// {"mode": "" | "local" | "lan", "port": n, "newKey": true}, each part
+// optional, and answers the same. The app's own windows' alone: a browser
+// on the page can't turn it off under itself, nor read the key it came in
+// without.
+func appPageRoutes(mux *http.ServeMux) {
+	mux.HandleFunc("GET /api/web-page", func(rw http.ResponseWriter, r *http.Request) {
+		writeJSON(rw, appPageServer.state())
+	})
+	mux.HandleFunc("POST /api/web-page", func(rw http.ResponseWriter, r *http.Request) {
+		var in struct {
+			Mode   *string `json:"mode"`
+			Port   *int    `json:"port"`
+			NewKey bool    `json:"newKey"`
+		}
+		if err := json.NewDecoder(http.MaxBytesReader(rw, r.Body, 4096)).Decode(&in); err != nil {
+			fail(rw, err)
+			return
+		}
+		c, err := loadAppPage()
+		if err != nil {
+			// a file that can't be read is written anew only when the
+			// whole choice is given
+			if in.Mode == nil {
+				fail(rw, err)
+				return
+			}
+			c = appPageConf{}
+		}
+		if in.Mode != nil {
+			switch *in.Mode {
+			case "", "local", "lan":
+				c.Mode = *in.Mode
+			default:
+				fail(rw, fmt.Errorf("browser access is off, local or lan, not %q", *in.Mode))
+				return
+			}
+		}
+		if in.Port != nil {
+			if err := appPagePortOK(*in.Port); err != nil {
+				fail(rw, err)
+				return
+			}
+			c.Port = *in.Port
+			if c.Port == appPageDefaultPort {
+				c.Port = 0
+			}
+		}
+		if in.NewKey || CheckWebKey(c.Key) != nil {
+			c.Key = NewWebKey()
+		}
+		if err := saveAppPage(c); err != nil {
+			fail(rw, err)
+			return
+		}
+		appPageServer.apply()
+		appPageServer.nudge()
+		writeJSON(rw, appPageServer.state())
+	})
+}
+
+// appPagePortOK says what is wrong with port for the page: it is a port of
+// its own, 1024 up, not the gateway's.
+func appPagePortOK(port int) error {
+	if port < 1024 || port > 65535 {
+		return errors.New("a port is a number from 1024 to 65535")
+	}
+	if u, err := url.Parse(gateway.URL()); err == nil && u.Port() == strconv.Itoa(port) {
+		return fmt.Errorf("port %d is the gateway's: pick another one", port)
+	}
+	return nil
+}
diff --git a/internal/gui/apppage_test.go b/internal/gui/apppage_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..e9dd3ce7ab5323f7606790ee32890131551e424d
--- /dev/null
+++ b/internal/gui/apppage_test.go
@@ -0,0 +1,313 @@
+package gui
+
+import (
+	"encoding/json"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"runtime"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/gateway"
+)
+
+// appPageTest is a fresh home and a fresh appPage in appPageServer's place,
+// its page a teapot that says it was reached. Whatever it serves is closed
+// when the test ends.
+func appPageTest(t *testing.T, reached *bool) *appPage {
+	t.Helper()
+	onePortHome(t)
+	g := gateway.New()
+	prevGW := served.Swap(g)
+	p := &appPage{wake: make(chan struct{}, 1)}
+	p.mk = func() http.Handler {
+		return http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+			*reached = true
+			rw.WriteHeader(http.StatusTeapot)
+		})
+	}
+	prev := appPageServer
+	appPageServer = p
+	t.Cleanup(func() {
+		p.mu.Lock()
+		if p.srv != nil {
+			p.srv.Close()
+		}
+		p.mu.Unlock()
+		appPageServer = prev
+		served.Store(prevGW)
+	})
+	return p
+}
+
+// appPagePost is POST /api/web-page on the app's windows' API.
+func appPagePost(t *testing.T, body string) (int, appPageJSON) {
+	t.Helper()
+	mux := http.NewServeMux()
+	appPageRoutes(mux)
+	r := httptest.NewRequest("POST", "/api/web-page", strings.NewReader(body))
+	w := httptest.NewRecorder()
+	mux.ServeHTTP(w, r)
+	var s appPageJSON
+	json.Unmarshal(w.Body.Bytes(), &s)
+	return w.Code, s
+}
+
+// noRedirect is a client that shows a redirect rather than following it.
+var noRedirect = &http.Client{
+	Timeout:       5 * time.Second,
+	CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+}
+
+func appPageGet(t *testing.T, port int, path, cookie string, hdr ...string) *http.Response {
+	t.Helper()
+	r, _ := http.NewRequest("GET", "http://127.0.0.1:"+strconv.Itoa(port)+path, nil)
+	if cookie != "" {
+		r.AddCookie(&http.Cookie{Name: "magpie_web_" + strconv.Itoa(port), Value: cookie})
+	}
+	for i := 0; i+1 < len(hdr); i += 2 {
+		r.Header.Set(hdr[i], hdr[i+1])
+	}
+	res, err := noRedirect.Do(r)
+	if err != nil {
+		t.Fatalf("GET %s: %v", path, err)
+	}
+	res.Body.Close()
+	return res
+}
+
+// jiakun_zhao on X: the page the app's window shows, served to a browser
+// (through a Cloudflare tunnel) by the app itself rather than `magpie web`
+// kept running beside it. It is off until Settings turns it on, and never
+// answers without its key: not the page, not its API, not the gateway's
+// client routes without a gateway key; a new key turns every browser
+// signed in with the old one away.
+func TestAppPageServesOnlyWithItsKey(t *testing.T) {
+	var reached bool
+	p := appPageTest(t, &reached)
+	if a, k := AppPage(); a != "" || k != "" {
+		t.Fatalf("a new home serves the page at %q", a)
+	}
+	port := freePort(t)
+
+	code, s := appPagePost(t, `{"mode":"local","port":`+strconv.Itoa(port)+`}`)
+	if code != 200 || !s.Serving || s.Mode != "local" || s.Port != port {
+		t.Fatalf("turned on: %d %+v", code, s)
+	}
+	key := strings.TrimPrefix(s.Link, "http://127.0.0.1:"+strconv.Itoa(port)+"/?k=")
+	if CheckWebKey(key) != nil || key == s.Link {
+		t.Fatalf("the link carries no key: %q", s.Link)
+	}
+	if a, k := AppPage(); a != "127.0.0.1:"+strconv.Itoa(port) || k != key {
+		t.Errorf("AppPage() = %q, %q", a, k)
+	}
+	if runtime.GOOS != "windows" {
+		if fi, err := os.Stat(appPageFile()); err != nil || fi.Mode().Perm() != 0o600 {
+			t.Errorf("web-page.json: %v %v, want 0600", fi.Mode(), err)
+		}
+	}
+	if b, _ := os.ReadFile(appPageFile()); !strings.Contains(string(b), key) {
+		t.Errorf("the key is not in web-page.json: %s", b)
+	}
+	// only on this computer
+	if _, err := net.DialTimeout("tcp", "127.0.0.1:"+strconv.Itoa(port), time.Second); err != nil {
+		t.Fatal(err)
+	}
+	if p.addr != "127.0.0.1:"+strconv.Itoa(port) {
+		t.Errorf("local listens on %q", p.addr)
+	}
+
+	for _, c := range []struct {
+		name, path, cookie string
+		hdr                []string
+	}{
+		{"the page", "/", "", nil},
+		{"the page, as a browser", "/", "", []string{"Accept", "text/html"}},
+		{"the API", "/api/state", "", nil},
+		{"the API, from another host", "/api/state", "", []string{"Host", "rebind.attacker.example:" + strconv.Itoa(port)}},
+		{"the API, Origin null", "/api/state", "", []string{"Origin", "null"}},
+		{"the API, a wrong cookie", "/api/state", "0123456789abcdef-wrong", nil},
+		{"the page, a wrong key in the link", "/?k=0123456789abcdef-wrong", "", nil},
+	} {
+		res := appPageGet(t, port, c.path, c.cookie, c.hdr...)
+		if res.StatusCode == http.StatusTeapot || res.StatusCode == 200 || res.StatusCode == http.StatusSeeOther {
+			t.Errorf("%s without the key: %d", c.name, res.StatusCode)
+		}
+	}
+	if reached {
+		t.Fatal("the page was reached without its key")
+	}
+	// the gateway's client routes on the page's port need a gateway key,
+	// from this computer too (a tunnel's requests come from loopback)
+	if res := appPageGet(t, port, "/v1/models", ""); res.StatusCode == 200 {
+		t.Errorf("/v1/models without a gateway key: %d", res.StatusCode)
+	}
+	// shared: a gateway key, and nothing less, lets an agent through
+	gwKey := onePortKey(t)
+	if res := appPageGet(t, port, "/v1/models", ""); res.StatusCode == 200 {
+		t.Errorf("/v1/models shared, without a gateway key: %d", res.StatusCode)
+	}
+	if res := appPageGet(t, port, "/v1/models", key); res.StatusCode == 200 {
+		t.Errorf("/v1/models with the page's cookie alone: %d", res.StatusCode)
+	}
+	if res := appPageGet(t, port, "/v1/models", "", "Authorization", "Bearer "+gwKey); res.StatusCode != 200 {
+		t.Errorf("/v1/models with a gateway key: %d", res.StatusCode)
+	}
+
+	res := appPageGet(t, port, "/?k="+key, "")
+	var cookie string
+	for _, c := range res.Cookies() {
+		if c.Name == "magpie_web_"+strconv.Itoa(port) {
+			cookie = c.Value
+		}
+	}
+	if res.StatusCode != http.StatusSeeOther || cookie != key {
+		t.Fatalf("the link: %d, cookie %q", res.StatusCode, cookie)
+	}
+	if res := appPageGet(t, port, "/api/state", cookie); res.StatusCode != http.StatusTeapot {
+		t.Fatalf("signed in: %d", res.StatusCode)
+	}
+
+	// a new key: the old cookie is turned away, the new link signs in
+	code, s = appPagePost(t, `{"newKey":true}`)
+	if code != 200 || !s.Serving || strings.Contains(s.Link, key) {
+		t.Fatalf("new key: %d %+v", code, s)
+	}
+	reached = false
+	if res := appPageGet(t, port, "/api/state", cookie); res.StatusCode != http.StatusUnauthorized || reached {
+		t.Errorf("the old key's cookie after a new key: %d", res.StatusCode)
+	}
+	if res := appPageGet(t, port, strings.TrimPrefix(s.Link, "http://127.0.0.1:"+strconv.Itoa(port)), ""); res.StatusCode != http.StatusSeeOther {
+		t.Errorf("the new link: %d", res.StatusCode)
+	}
+
+	// off: nothing listens
+	if code, s = appPagePost(t, `{"mode":""}`); code != 200 || s.Serving || s.Link != "" {
+		t.Fatalf("turned off: %d %+v", code, s)
+	}
+	if c, err := net.DialTimeout("tcp", "127.0.0.1:"+strconv.Itoa(port), time.Second); err == nil {
+		c.Close()
+		t.Error("the page still listens once turned off")
+	}
+	if a, _ := AppPage(); a != "" {
+		t.Errorf("AppPage() once off = %q", a)
+	}
+}
+
+// A port another program holds (`magpie web`, or the magpie before a
+// restart to update) is said, and taken once it is let go.
+func TestAppPageWaitsForABusyPort(t *testing.T) {
+	var reached bool
+	p := appPageTest(t, &reached)
+	held, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := held.Addr().(*net.TCPAddr).Port
+	code, s := appPagePost(t, `{"mode":"local","port":`+strconv.Itoa(port)+`}`)
+	if code != 200 || s.Serving || !strings.Contains(s.Error, "port "+strconv.Itoa(port)) {
+		t.Fatalf("on a held port: %d %+v", code, s)
+	}
+	if !p.waiting() {
+		t.Error("a held port isn't tried again")
+	}
+	held.Close()
+	p.apply()
+	if s := p.state(); !s.Serving || s.Error != "" {
+		t.Fatalf("once let go: %+v", s)
+	}
+	if p.waiting() {
+		t.Error("still trying once served")
+	}
+}
+
+// A web-page.json that can't be read as a choice serves nothing, and says
+// why; Settings writes it anew only with the whole choice.
+func TestAppPageUnreadFileServesNothing(t *testing.T) {
+	for _, body := range []string{"{not json", `{"mode":"everywhere","key":"0123456789abcdef-key"}`} {
+		var reached bool
+		p := appPageTest(t, &reached)
+		if err := os.MkdirAll(strings.TrimSuffix(appPageFile(), "web-page.json"), 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(appPageFile(), []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		p.apply()
+		if s := p.state(); s.Serving || s.Error == "" || s.Link != "" {
+			t.Errorf("%s: %+v", body, s)
+		}
+		if a, _ := AppPage(); a != "" {
+			t.Errorf("%s: AppPage() = %q", body, a)
+		}
+		if code, _ := appPagePost(t, `{"newKey":true}`); code == 200 {
+			t.Errorf("%s: a new key alone wrote the file", body)
+		}
+		if code, s := appPagePost(t, `{"mode":""}`); code != 200 || s.Error != "" {
+			t.Errorf("%s: turned off: %d %+v", body, code, s)
+		}
+	}
+}
+
+// Settings turns down what isn't a choice: a mode not known, a port below
+// 1024 or the gateway's own.
+func TestAppPageTurnsDownBadChoices(t *testing.T) {
+	var reached bool
+	appPageTest(t, &reached)
+	gwPort := freePort(t)
+	t.Setenv("MAGPIE_ADDR", "127.0.0.1:"+strconv.Itoa(gwPort))
+	for _, body := range []string{`{"mode":"everywhere"}`, `{"port":80}`, `{"port":70000}`, `{"port":` + strconv.Itoa(gwPort) + `}`} {
+		if code, _ := appPagePost(t, body); code == 200 {
+			t.Errorf("%s was taken", body)
+		}
+	}
+	if _, err := os.Stat(appPageFile()); err == nil {
+		t.Error("a choice turned down was written")
+	}
+}
+
+// A browser on the app's page is a browser tab: its page says web, the
+// app's Browser access isn't on its API (it can't turn the page off under
+// itself, nor read the key), and it doesn't make the app's own windows
+// `magpie web`'s (webPage).
+func TestAppPageBrowserIsATab(t *testing.T) {
+	onePortHome(t)
+	webPage.Store(false)
+	t.Cleanup(func() { webPage.Store(false) })
+	b := appWebHost{webHost{}, nil}
+	if !isWeb(b) || ownWeb(b) {
+		t.Fatalf("isWeb %v, ownWeb %v", isWeb(b), ownWeb(b))
+	}
+	h := Handler(b, nil)
+	if webPage.Load() {
+		t.Error("the app's page set webPage, as magpie web's does")
+	}
+	for _, m := range []string{"GET", "POST"} {
+		r := httptest.NewRequest(m, "/api/web-page", strings.NewReader(`{"mode":"lan"}`))
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		if w.Code == 200 {
+			t.Errorf("%s /api/web-page from the browser: %d %s", m, w.Code, w.Body)
+		}
+	}
+	if _, err := os.Stat(appPageFile()); err == nil {
+		t.Error("the browser wrote web-page.json")
+	}
+	r := httptest.NewRequest("GET", "/boot.js", nil)
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, r)
+	if !strings.Contains(w.Body.String(), `"web":true`) {
+		t.Errorf("boot.js doesn't say web: %.200s", w.Body)
+	}
+	// the app's own windows have it
+	r = httptest.NewRequest("GET", "/api/web-page", nil)
+	w = httptest.NewRecorder()
+	Handler(nil, nil).ServeHTTP(w, r)
+	if w.Code != 200 {
+		t.Errorf("GET /api/web-page from the app: %d", w.Code)
+	}
+}
