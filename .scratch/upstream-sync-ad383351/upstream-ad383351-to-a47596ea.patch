diff --git a/internal/gateway/codex_desktop.go b/internal/gateway/codex_desktop.go
new file mode 100644
index 0000000000000000000000000000000000000000..160408139ef6bdd020d12eafbf9b70e5d1cc40b6
--- /dev/null
+++ b/internal/gateway/codex_desktop.go
@@ -0,0 +1,101 @@
+package gateway
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"log"
+	"sync"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// The Codex app's picker shows only the models of Codex's list that a
+// flag of OpenAI's names, for Codex on its built-in provider, unless Codex
+// reads its list from a file (model_catalog_json): beside the ChatGPT
+// sign-in it showed GPT alone, magpie's models in the list it was handed
+// all the same (laddieyao on Discord). The CLI shows the whole list. So
+// where the Codex app is installed, magpie writes the list it hands Codex
+// into a file for Codex to read (agent.CodexDesktopList), and Codex asks
+// for no list then: the backend's part of it is asked for here, with
+// Codex's sign-in, and kept.
+
+// CodexDesktopChanged is called when the backend's list for the Codex app
+// changed, for the file to be written again (agent.SyncCatalogSoon).
+var CodexDesktopChanged func()
+
+// codexDeskFetch asks the backend for its list (a test's stands in).
+var codexDeskFetch = provider.CodexLiveList
+
+const (
+	// codexDeskFor is how long a list the backend gave stands before it
+	// is asked for again; codexDeskRetry how long after one it didn't
+	codexDeskFor   = time.Hour
+	codexDeskRetry = 5 * time.Minute
+	codexDeskWait  = 30 * time.Second
+)
+
+var codexDesk struct {
+	sync.Mutex
+	body       []byte
+	got, tried time.Time
+	asking     bool
+	done       chan struct{} // closed as the ask under way ends
+}
+
+// CodexDesktopCatalog is the list a Codex beside its ChatGPT sign-in is
+// handed (/backend-api/codex/models), as a file Codex reads with
+// model_catalog_json: the backend's entries as it sent them, narrowed and
+// set as the codex provider has them, magpie's after them. ok is false
+// while the backend's list is not known: none asked for yet, or none it
+// gave. That is unknown, never an empty list, and the file as it was
+// stands. The backend is asked again in the background when its list is
+// old, CodexDesktopChanged told when it changed.
+func CodexDesktopCatalog() (b []byte, ok bool) {
+	codexDesk.Lock()
+	body := codexDesk.body
+	stale := body == nil || time.Since(codexDesk.got) >= codexDeskFor
+	if stale && !codexDesk.asking && time.Since(codexDesk.tried) >= codexDeskRetry {
+		codexDesk.asking, codexDesk.tried = true, time.Now()
+		codexDesk.done = make(chan struct{})
+		go codexDeskRefresh(codexDesk.done)
+	}
+	codexDesk.Unlock()
+	if body == nil {
+		return nil, false
+	}
+	// each caller's own copy: codexMerged writes into the entries
+	var list struct {
+		Models []any `json:"models"`
+	}
+	if json.Unmarshal(body, &list) != nil || len(list.Models) == 0 {
+		return nil, false
+	}
+	b, err := json.MarshalIndent(map[string]any{"models": codexMerged(list.Models, false)}, "", " ")
+	if err != nil {
+		return nil, false
+	}
+	return b, true
+}
+
+func codexDeskRefresh(done chan struct{}) {
+	ctx, cancel := context.WithTimeout(context.Background(), codexDeskWait)
+	defer cancel()
+	b, err := codexDeskFetch(ctx)
+	codexDesk.Lock()
+	changed := false
+	if err == nil {
+		changed = !bytes.Equal(b, codexDesk.body)
+		codexDesk.body, codexDesk.got = b, time.Now()
+	}
+	codexDesk.asking = false
+	codexDesk.Unlock()
+	if err != nil {
+		log.Println("codex: the ChatGPT backend's model list for the Codex app:", err)
+	}
+	if changed && CodexDesktopChanged != nil {
+		CodexDesktopChanged()
+	}
+	close(done)
+}
diff --git a/internal/gateway/codex_desktop_test.go b/internal/gateway/codex_desktop_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..990f0a9fda492de561ed2260bc8c9625b8fe8bd9
--- /dev/null
+++ b/internal/gateway/codex_desktop_test.go
@@ -0,0 +1,124 @@
+package gateway
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// codexDeskReset forgets the backend's list for the Codex app, before the
+// test and after it.
+func codexDeskReset(t *testing.T) {
+	t.Helper()
+	reset := func() {
+		codexDesk.Lock()
+		done := codexDesk.done
+		codexDesk.Unlock()
+		if done != nil {
+			<-done
+		}
+		codexDesk.Lock()
+		codexDesk.body, codexDesk.got, codexDesk.tried, codexDesk.asking, codexDesk.done = nil, time.Time{}, time.Time{}, false, nil
+		codexDesk.Unlock()
+	}
+	reset()
+	t.Cleanup(reset)
+	was := CodexDesktopChanged
+	t.Cleanup(func() { CodexDesktopChanged = was })
+}
+
+// codexDeskAsked waits for the ask CodexDesktopCatalog started.
+func codexDeskAsked(t *testing.T) {
+	t.Helper()
+	codexDesk.Lock()
+	done := codexDesk.done
+	codexDesk.Unlock()
+	if done == nil {
+		t.Fatal("the backend was never asked")
+	}
+	<-done
+}
+
+// The list the Codex app reads from a file beside the ChatGPT sign-in
+// (laddieyao on Discord): the backend's entries as it sent them, its
+// base_instructions untouched, asked for with Codex's own sign-in, and
+// magpie's models after them. Not known until the backend has answered,
+// and a failed ask after that keeps the last list it gave: unknown, never
+// an empty list.
+func TestCodexDesktopCatalog(t *testing.T) {
+	codexSignedIn(t)
+	codexDeskReset(t)
+	if err := provider.Save(provider.Provider{ID: "relay", Name: "Relay", Key: "k", Anthropic: "http://127.0.0.1:1",
+		Models: []string{"claude-opus-5.5"}}); err != nil {
+		t.Fatal(err)
+	}
+	var fail atomic.Bool
+	var auth atomic.Value
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		auth.Store(r.Header.Get("Authorization"))
+		if fail.Load() {
+			http.Error(w, "down", http.StatusBadGateway)
+			return
+		}
+		io.WriteString(w, `{"models":[{"slug":"gpt-5.5","priority":1,"base_instructions":"You are Codex, based on GPT-5.","visibility":"list"}]}`)
+	}))
+	defer up.Close()
+	was := provider.CodexBase
+	provider.CodexBase = up.URL + "/backend-api/codex"
+	defer func() { provider.CodexBase = was }()
+	var changed atomic.Int32
+	CodexDesktopChanged = func() { changed.Add(1) }
+
+	if b, ok := CodexDesktopCatalog(); ok || b != nil {
+		t.Fatalf("known before the backend answered: %s", b)
+	}
+	codexDeskAsked(t)
+	if changed.Load() != 1 {
+		t.Fatalf("changed told %d times", changed.Load())
+	}
+	if a, _ := auth.Load().(string); a == "" {
+		t.Fatal("asked without Codex's sign-in")
+	}
+	b, ok := CodexDesktopCatalog()
+	if !ok {
+		t.Fatal("not known after the backend answered")
+	}
+	var got struct {
+		Models []map[string]any `json:"models"`
+	}
+	if err := json.Unmarshal(b, &got); err != nil {
+		t.Fatal(err)
+	}
+	slugs := map[string]map[string]any{}
+	for _, m := range got.Models {
+		slugs[m["slug"].(string)] = m
+	}
+	if m := slugs["gpt-5.5"]; m == nil || m["base_instructions"] != "You are Codex, based on GPT-5." {
+		t.Fatalf("the backend's entry: %v", m)
+	}
+	if slugs["relay/claude-opus-5.5"] == nil {
+		t.Fatalf("magpie's models missing: %s", b)
+	}
+
+	// an ask that fails keeps the list the backend gave last
+	fail.Store(true)
+	codexDesk.Lock()
+	codexDesk.got, codexDesk.tried = time.Time{}, time.Time{}
+	codexDesk.Unlock()
+	if _, ok := CodexDesktopCatalog(); !ok {
+		t.Fatal("the last list forgotten as the backend is asked again")
+	}
+	codexDeskAsked(t)
+	if b2, ok := CodexDesktopCatalog(); !ok || string(b2) != string(b) {
+		t.Fatalf("after a failed ask: %v\n%s", ok, b2)
+	}
+	if changed.Load() != 1 {
+		t.Fatalf("a failed ask told as a change")
+	}
+}
