index 0000000000000000000000000000000000000000..f09dba19e9a4cb56bf4a2e36cabee2fe89867244
--- /dev/null
+++ b/internal/provider/zone_windows.go
@@ -0,0 +1,19 @@
+package provider
+
+import "golang.org/x/sys/windows/registry"
+
+// systemZoneName is Windows' name of this computer's time zone ("China
+// Standard Time"), which LocalZone can't read there; "" when the registry
+// doesn't say.
+func systemZoneName() string {
+	k, err := registry.OpenKey(registry.LOCAL_MACHINE, `SYSTEM\CurrentControlSet\Control\TimeZoneInformation`, registry.QUERY_VALUE)
+	if err != nil {
+		return ""
+	}
+	defer k.Close()
+	name, _, err := k.GetStringValue("TimeZoneKeyName")
+	if err != nil {
+		return ""
+	}
+	return name
+}
diff --git a/internal/redact/dateword.go b/internal/redact/dateword.go
new file mode 100644
index 0000000000000000000000000000000000000000..8f4ffbdae8538e0cfcb8f0136c83cacb344cada5
--- /dev/null
+++ b/internal/redact/dateword.go
@@ -0,0 +1,183 @@
+package redact
+
+import (
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+	"unicode/utf8"
+)
+
+// A masked word that is a date matches that calendar date however it is
+// written (JackyCcao on X: with birthdays off, the user's own birthday as a
+// masked word, 1990-05-12, let 1990/5/12, 1990年5月12日 and 19900512 go as
+// written). The word is a date when it is all of one: year, month and day
+// with - / . 、 or a space between (1990-05-12, 1990.5.12); 1990年5月12日 or
+// 1990년 5월 12일; day and month before the year where only one reading is
+// a date (13/05/1990, 05/13/1990, 05/05/1990, never 05/12/1990); or a month's
+// English name (May 12, 1990; 12 May 1990). Eight digits alone are not
+// taken for a date word: they are as likely an id.
+//
+// It then matches the same date, and only it, in each of those forms, with
+// or without leading zeros, and as eight digits (19900512); day-first and
+// month-first only where the day is over 12 or equals the month, so no
+// form can read as another date. A match never has a digit beside it, nor
+// a dot and a digit (1990.5.12.1 is a version, 11990-05-12 another number),
+// whatever Whole words only says: a date is matched as a whole date.
+
+// dateSep is what stands between a date's numbers.
+const dateSep = `(?:[ \t]*[-/.、／－][ \t]*|[ \t])`
+
+var (
+	dateYMD   = regexp.MustCompile(`^(\d{4})` + dateSep + `(\d{1,2})` + dateSep + `(\d{1,2})\.?$`)
+	dateCJK   = regexp.MustCompile(`^(\d{4})[ \t]*[年년][ \t]*(\d{1,2})[ \t]*[月월][ \t]*(\d{1,2})[ \t]*[日号號일]?$`)
+	dateDMY   = regexp.MustCompile(`^(\d{1,2})` + dateSep + `(\d{1,2})` + dateSep + `(\d{4})$`)
+	dateNameF = regexp.MustCompile(`^([A-Za-z]+)\.?[ \t]+(\d{1,2})(?:st|nd|rd|th)?,?[ \t]+(\d{4})$`)
+	dateNameB = regexp.MustCompile(`^(\d{1,2})(?:st|nd|rd|th)?(?:[ \t]+|-)([A-Za-z]+)\.?,?(?:[ \t]+|-)(\d{4})$`)
+)
+
+var monthNames = []string{"January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"}
+
+// monthOf is the month a name or its first three letters say, 0 for none.
+func monthOf(name string) int {
+	l := strings.ToLower(name)
+	if l == "sept" {
+		return 9
+	}
+	for i, m := range monthNames {
+		ml := strings.ToLower(m)
+		if l == ml || len(l) == 3 && strings.HasPrefix(ml, l) {
+			return i + 1
+		}
+	}
+	return 0
+}
+
+// realDate says y-m-d is a day of the calendar.
+func realDate(y, m, d int) bool {
+	if y < 1000 || y > 2999 || m < 1 || m > 12 || d < 1 {
+		return false
+	}
+	t := time.Date(y, time.Month(m), d, 0, 0, 0, 0, time.UTC)
+	return t.Day() == d && int(t.Month()) == m
+}
+
+// parseDateWord is the date the word w is, where it is one.
+func parseDateWord(w string) (y, m, d int, ok bool) {
+	n := func(s string) int { v, _ := strconv.Atoi(s); return v }
+	if g := dateYMD.FindStringSubmatch(w); g != nil {
+		y, m, d = n(g[1]), n(g[2]), n(g[3])
+	} else if g := dateCJK.FindStringSubmatch(w); g != nil {
+		y, m, d = n(g[1]), n(g[2]), n(g[3])
+	} else if g := dateDMY.FindStringSubmatch(w); g != nil {
+		p, q := n(g[1]), n(g[2])
+		y = n(g[3])
+		switch {
+		case p == q:
+			m, d = p, q
+		case p > 12 && q <= 12:
+			d, m = p, q
+		case q > 12 && p <= 12:
+			m, d = p, q
+		default: // 05/12/1990: May 12th or December 5th
+			return 0, 0, 0, false
+		}
+	} else if g := dateNameF.FindStringSubmatch(w); g != nil {
+		m, d, y = monthOf(g[1]), n(g[2]), n(g[3])
+	} else if g := dateNameB.FindStringSubmatch(w); g != nil {
+		d, m, y = n(g[1]), monthOf(g[2]), n(g[3])
+	} else {
+		return 0, 0, 0, false
+	}
+	return y, m, d, realDate(y, m, d)
+}
+
+// dateForms is a pattern for the date y-m-d in each form a date word
+// matches, and the word itself as written.
+func dateForms(y, m, d int, w string) string {
+	num := func(v int) string { // 5 or 05; 12
+		if v < 10 {
+			return "0?" + strconv.Itoa(v)
+		}
+		return strconv.Itoa(v)
+	}
+	Y, M, D := strconv.Itoa(y), num(m), num(d)
+	full, abbr := monthNames[m-1], monthNames[m-1][:3]
+	if m == 9 {
+		abbr = "Sept|Sep"
+	}
+	name := `(?i:` + full + `|(?:` + abbr + `)\.?)`
+	ord := `(?:st|nd|rd|th)?`
+	forms := []string{
+		Y + dateSep + M + dateSep + D,
+		Y + `[ \t]*年[ \t]*` + M + `[ \t]*月[ \t]*` + D + `(?:[ \t]*[日号號])?`,
+		Y + `[ \t]*년[ \t]*` + M + `[ \t]*월[ \t]*` + D + `(?:[ \t]*일)?`,
+		Y + strconv.Itoa(100 + m)[1:] + strconv.Itoa(100 + d)[1:],
+		name + `[ \t]+` + D + ord + `,?[ \t]+` + Y,
+		D + ord + `(?:[ \t]+|-)` + name + `,?(?:[ \t]+|-)` + Y,
+	}
+	// day-first and month-first only where no other date reads the same
+	if d > 12 || d == m {
+		forms = append(forms, D+dateSep+M+dateSep+Y)
+		if d != m {
+			forms = append(forms, M+dateSep+D+dateSep+Y)
+		}
+	}
+	return `(?:` + strings.Join(forms, "|") + `|` + regexp.QuoteMeta(w) + `)`
+}
+
+var dateWords sync.Map // word → *regexp.Regexp, or nil for one that is no date
+
+// dateWord is the pattern for the date the masked word w is, nil where it
+// is no date.
+func dateWord(w string) *regexp.Regexp {
+	if re, ok := dateWords.Load(w); ok {
+		return re.(*regexp.Regexp)
+	}
+	var re *regexp.Regexp
+	if y, m, d, ok := parseDateWord(w); ok {
+		re = regexp.MustCompile(dateForms(y, m, d, w))
+	}
+	dateWords.Store(w, re)
+	return re
+}
+
+// dateWhole says the date at s[a:b] is no part of a longer number: no
+// digit beside it, no dot and a digit (a version's 1990.5.12.1, 3.1990.5.12),
+// and no letter before a month's name (xMay), save in a script that puts
+// no spaces between words (生日是May 12, 1990).
+func dateWhole(s string, a, b int) bool {
+	isDigit := func(c byte) bool { return c >= '0' && c <= '9' }
+	if a > 0 {
+		if isDigit(s[a-1]) || s[a-1] == '.' && a > 1 && isDigit(s[a-2]) {
+			return false
+		}
+		if r, _ := utf8.DecodeLastRuneInString(s[:a]); unicode.IsLetter(rune(s[a])) && unicode.IsLetter(r) && !unicode.In(r, unicode.Han, unicode.Hiragana, unicode.Katakana, unicode.Hangul) {
+			return false
+		}
+	}
+	if b < len(s) {
+		if isDigit(s[b]) || s[b] == '.' && b+1 < len(s) && isDigit(s[b+1]) {
+			return false
+		}
+	}
+	return true
+}
+
+// dateSpans are where s has the date the masked word w is, nil and false
+// where w is no date.
+func dateSpans(s, w string) ([]span, bool) {
+	re := dateWord(w)
+	if re == nil {
+		return nil, false
+	}
+	var out []span
+	for _, m := range re.FindAllStringIndex(s, -1) {
+		if dateWhole(s, m[0], m[1]) {
+			out = append(out, span{m[0], m[1], "TERM", ByWord})
+		}
+	}
+	return out, true
+}
diff --git a/internal/redact/dateword_test.go b/internal/redact/dateword_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..ffdf74c21d1012bf203ae9e900344149365594f0
--- /dev/null
+++ b/internal/redact/dateword_test.go
@@ -0,0 +1,132 @@
+package redact
+
+import (
+	"strings"
+	"testing"
+	"time"
+)
+
+// JackyCcao on X turned birthdays off and put their own birthday in
+// Masked words, and asked that a date word catch the same date written
+// with another separator or as 年月日. A date word matches that calendar
+// date in every common form, and never another date or a longer number.
+func TestDateWordEveryForm(t *testing.T) {
+	forms := []string{
+		"1990-05-12", "1990-5-12", "1990/05/12", "1990/5/12", "1990.05.12", "1990.5.12",
+		"1990、5、12", "1990 5 12", "1990 / 05 / 12", "1990. 5. 12",
+		"1990年5月12日", "1990年05月12日", "1990 年 5 月 12 日", "1990年5月12号", "1990年5月12",
+		"1990년 5월 12일", "19900512",
+		"May 12, 1990", "May 12th 1990", "may 12 1990", "12 May 1990", "12-May-1990",
+	}
+	for _, word := range []string{"1990-05-12", "1990/5/12", "1990年5月12日", "May 12, 1990", "12 May 1990"} {
+		o := Options{Words: []string{word}}
+		for _, f := range forms {
+			for _, in := range []string{f, "生日是" + f + "，记得", "born " + f + ".", `{"dob":"` + f + `"}`, "IMG_" + f + "_1.jpg", f + "T08:00:00Z"} {
+				out, n := Mask(in, o)
+				if n != 1 || strings.Contains(out, f) {
+					t.Errorf("word %q: %q masked %d as %q", word, in, n, out)
+					continue
+				}
+				if back := Restore(out, false); back != in {
+					t.Errorf("word %q: %q came back as %q", word, in, back)
+				}
+			}
+		}
+	}
+}
+
+// Day-first and month-first forms only where one reading is a date: for
+// May 13th both 13/05/1990 and 05/13/1990 are; for May 12th neither
+// 05/12/1990 nor 12/05/1990 (December 5th) is, and a word written so is
+// matched only as written.
+func TestDateWordDayMonthOrder(t *testing.T) {
+	for _, c := range []struct {
+		word, in string
+		n        int
+	}{
+		{"1990-05-13", "13/05/1990", 1},
+		{"1990-05-13", "05/13/1990", 1},
+		{"1990-05-13", "13.5.1990", 1},
+		{"13.05.1990", "1990年5月13日", 1},
+		{"05/13/1990", "1990-05-13", 1},
+		{"1990-05-05", "05/05/1990", 1},
+		{"1990-05-12", "05/12/1990", 0},
+		{"1990-05-12", "12/05/1990", 0},
+		{"1990-05-12", "12.05.1990", 0},
+		{"05/12/1990", "1990-05-12", 0}, // May 12th or December 5th: no date
+		{"05/12/1990", "1990-12-05", 0},
+		{"05/12/1990", "on 05/12/1990.", 1}, // still the word as written
+	} {
+		if _, n := Mask(c.in, Options{Words: []string{c.word}}); n != c.n {
+			t.Errorf("word %q: %q masked %d, want %d", c.word, c.in, n, c.n)
+		}
+	}
+}
+
+// A date word never matches another date, a longer number, or a version
+// that starts as the date does.
+func TestDateWordNotAnotherDate(t *testing.T) {
+	for _, word := range []string{"1990-05-12", "1990.5.12", "1990年5月12日"} {
+		for _, in := range []string{
+			"1990-05-13", "1990-12-05", "1991-05-12", "1990年5月1日", "1990年5月120日", "1990/05/1",
+			"1990.5.12.1", "v1990.5.12.1", "3.1990.5.12", "11990-05-12", "1990-05-123", "199005123", "2199005120",
+			"19900513", "1990512", "May 13, 1990", "Mayday 12 1990", "12/05/1990", "05/12/1990",
+		} {
+			if out, n := Mask(in, Options{Words: []string{word}}); n != 0 || out != in {
+				t.Errorf("word %q: %q masked as %q", word, in, out)
+			}
+		}
+	}
+	// a full stop after the date ends a sentence; it is no version
+	if _, n := Mask("生日 1990.5.12.", Options{Words: []string{"1990-05-12"}}); n != 1 {
+		t.Errorf("date before a full stop not masked")
+	}
+}
+
+// What is no date stays a word as before: eight digits (as likely an id),
+// a date that isn't one, a word with a date in it.
+func TestDateWordOnlyADate(t *testing.T) {
+	for _, c := range []struct{ word, in string }{
+		{"19900512", "1990-05-12"},
+		{"1990-02-30", "1990/2/30"},
+		{"1990-13-01", "1990/13/1"},
+		{"release-1990-05-12", "1990-05-12"},
+	} {
+		if out, n := Mask(c.in, Options{Words: []string{c.word}}); n != 0 {
+			t.Errorf("word %q: %q masked as %q", c.word, c.in, out)
+		}
+	}
+	// and is found inside a longer one as before
+	if _, n := Mask("x19900512y", Options{Words: []string{"19900512"}}); n != 1 {
+		t.Errorf("eight-digit word no longer found inside a longer one")
+	}
+}
+
+// The birthday rule needs a birthday's word right before the date, so a
+// log's or a task's own date is not one, however old. A date of birth
+// stored as a time, as a database or JavaScript writes it, is still a
+// birthday: the time beside a date doesn't say it is a log's (#3878).
+func TestBirthdayLogDates(t *testing.T) {
+	defer func(c func() time.Time) { dateClock = c }(dateClock)
+	dateClock = func() time.Time { return time.Date(2026, 10, 27, 9, 0, 0, 0, time.Local) }
+	for _, s := range []string{
+		"2019-03-02 10:00:01 INFO birthday reminder sent to user 42",
+		"[2019-03-02T10:00:01Z] 生日提醒已发送",
+		"logs/2019-03-02.log: born-again job finished",
+		"任务创建于 2019-03-02，生日活动筹备",
+		"2019-03-02 生日",
+	} {
+		if out, n := Mask(s, allKinds()); n != 0 || out != s {
+			t.Errorf("%q masked as %q", s, out)
+		}
+	}
+	for _, s := range []string{
+		`{"birthday":"1990-05-11T16:00:00.000Z"}`,
+		"出生日期：1990-05-12 00:00:00",
+		"生日：2019-03-02",
+	} {
+		if out, _ := Mask(s, allKinds()); !strings.Contains(out, "BIRTHDAY") {
+			t.Errorf("%q not masked: %q", s, out)
+		}
+	}
+}
