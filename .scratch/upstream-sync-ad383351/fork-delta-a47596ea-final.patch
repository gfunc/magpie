+		if isErr {
+			t.Fatalf("web_fetch: %q", got)
+		}
+		return got
+	}
+	name := func(v string) {
+		st := settings.Load()
+		st.Fetch = v
+		if err := settings.Save(st); err != nil {
+			t.Fatal(err)
+		}
+	}
+	name("office")
+	if got := read(); got != remoteFetchText || len(s.log()) != 1 {
+		t.Fatalf("named: %q %q", got, s.log())
+	}
+	if FetchUnused() != "" {
+		t.Fatalf("unused %q", FetchUnused())
