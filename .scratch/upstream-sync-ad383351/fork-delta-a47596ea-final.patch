--- a/internal/filememo/filememo.go
+++ b/internal/filememo/filememo.go
@@ -85,27 +85,50 @@ func Hold() (release func()) {
 // Forget has every file looked at again on its next read: magpie wrote
 // one.
 func Forget() {
+	renewMu.Lock()
+	defer renewMu.Unlock()
 	mu.Lock()
 	gen++
 	gens.Store(gen)
-	close(written)
-	written = make(chan struct{})
 	mu.Unlock()
+	renew <- struct{}{}
+	<-renewed
 }
 
 // wake has every loop waiting on Written look at its files, with nothing
 // read forgotten: another process wrote one (Watch), which a look at the
 // disk tells.
 func wake() {
-	mu.Lock()
-	close(written)
-	written = make(chan struct{})
-	mu.Unlock()
+	renewMu.Lock()
+	defer renewMu.Unlock()
+	renew <- struct{}{}
+	<-renewed
 }
 
-// written is closed, and made anew, by every Forget.
+// written is replaced on every Forget, with the old channel closed by the relay.
 var written = make(chan struct{})
 
+// renew and renewed belong to no test bubble. The relay makes every
+// replacement written channel there, and renewMu pairs each swap with its
+// acknowledgement.
+var (
+	renew   = make(chan struct{})
+	renewed = make(chan struct{})
+	renewMu sync.Mutex
+)
+
+func init() {
+	go func() {
+		for range renew {
+			mu.Lock()
+			close(written)
+			written = make(chan struct{})
+			mu.Unlock()
+			renewed <- struct{}{}
+		}
+	}()
+}
+
 // Written is closed by the next write magpie makes (Forget), or by
 // another process's that Watch is told of: a loop that follows magpie's
 // files waits on it, and looks at them only every so often (OthersEvery)
diff --git a/internal/gateway/apijson.go b/internal/gateway/apijson.go
new file mode 100644
index 00000000..7644a64c
--- /dev/null
+++ b/internal/gateway/apijson.go
@@ -0,0 +1,144 @@
+package gateway
+
+import (
+	"net/http"
+	"os"
+	"slices"
+	"strings"
+
+	"github.com/yetone/magpie/internal/catalog"
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// registryDefaultEffort is the thinking level MAGPIE_REGISTRY_DEFAULT_EFFORT
+// offers as every able model's default_effort in the registry ("max", say):
+// a client like kimi-code starts a model there instead of on the middle of
+// its levels. "" (unset) offers none, and a level the model doesn't take is
+// checked away by the caller.
+func registryDefaultEffort() string {
+	return strings.ToLower(strings.TrimSpace(os.Getenv("MAGPIE_REGISTRY_DEFAULT_EFFORT")))
+}
+
+// apiJSONBuckets are the registry's entries, one per wire the gateway can
+// be imported on: each becomes a [providers] entry of the client that
+// imports the gateway as a custom registry, a model appearing under a
+// bucket only when the gateway passes it through on that wire
+// untranslated, and the routing groups on the OpenAI one alone.
+var apiJSONBuckets = []struct {
+	id, name, typ string
+	api           func(base string) string
+	native        string
+}{
+	{"magpie-openai", "Magpie (OpenAI Chat)", "openai", func(b string) string { return b + "/v1" }, "/v1/chat/completions"},
+	{"magpie-anthropic", "Magpie (Anthropic Messages)", "anthropic", func(b string) string { return b }, "/v1/messages"},
+	{"magpie-openai-responses", "Magpie (OpenAI Responses)", "openai_responses", func(b string) string { return b + "/v1" }, "/v1/responses"},
+	{"magpie-group", "Magpie (Routing groups)", "openai", func(b string) string { return b + "/v1" }, ""},
+}
+
+// apiJSON answers GET /api.json with the gateway as a models.dev-shaped
+// custom registry (kimi-code's /provider paste, refreshed by it at startup):
+// id, name, api and type per bucket, and per model the fields that importer
+// reads — id kept in magpie's provider/model form, unknown window sizes and
+// prices left out rather than invented. The api base is MAGPIE_PUBLIC_URL
+// when set, else the address the registry was fetched on.
+func (s *Server) apiJSON(w http.ResponseWriter, r *http.Request) {
+	base := strings.TrimSuffix(os.Getenv("MAGPIE_PUBLIC_URL"), "/")
+	if base == "" {
+		scheme := "http"
+		if r.TLS != nil {
+			scheme = "https"
+		}
+		base = scheme + "://" + r.Host
+	}
+	var price func(provider.Entry) (catalog.Price, bool)
+	if local(r) || sharedWith(r) {
+		st, find := settings.Load(), provider.GroupFinder()
+		price = func(e provider.Entry) (catalog.Price, bool) { return provider.EntryPriceIn(st, find, e) }
+	} else {
+		price = func(provider.Entry) (catalog.Price, bool) { return catalog.Price{}, false }
+	}
+	bucketEntries := make([][]provider.Entry, len(apiJSONBuckets))
+	for _, e := range catalogFor(r) {
+		if e.Group != "" {
+			bucketEntries[len(apiJSONBuckets)-1] = append(bucketEntries[len(apiJSONBuckets)-1], e)
+			continue
+		}
+		native := provider.NativeEndpoints(e)
+		for i, b := range apiJSONBuckets {
+			if b.native != "" && slices.Contains(native, b.native) {
+				bucketEntries[i] = append(bucketEntries[i], e)
+			}
+		}
+	}
+	out := map[string]any{}
+	for i, b := range apiJSONBuckets {
+		models := map[string]any{}
+		labels := provider.Labels(bucketEntries[i])
+		for j, e := range bucketEntries[i] {
+			// the registry's key and its id agree: a group's bare id
+			// (models.dev keeps a model's id equal to its key)
+			if e.Group != "" {
+				e.ID = strings.TrimPrefix(e.ID, "group/")
+			}
+			models[e.ID] = apiJSONModel(e, labels[j], price)
+		}
+		out[b.id] = map[string]any{"id": b.id, "name": b.name, "api": b.api(base), "type": b.typ, "models": models}
+	}
+	writeJSON(w, 200, out)
+}
+
+// apiJSONModel is one model of the registry, in the shape the importer
+// reads: name (the agent-list label, its provider's after it, as Labels
+// names the models of an agent's own list — honoring the plain-names
+// settings, and disambiguating same-named models within the bucket),
+// limit (context and output when known), tool_call, reasoning and its
+// efforts (a group's own: the catalog computes them over the live
+// members, the intersection of their levels, a fixed member's level, or
+// the group's Levels, as the gateway serves them), the modalities as
+// magpie lists them, and cost when a price is known. Fields magpie
+// doesn't know are omitted, so the importer fills its own defaults
+// instead of trusting an invented number.
+func apiJSONModel(e provider.Entry, name string, price func(provider.Entry) (catalog.Price, bool)) map[string]any {
+	m := map[string]any{"id": e.ID, "tool_call": true}
+	if name != "" {
+		m["name"] = name
+	}
+	limit := map[string]any{}
+	if e.Context > 0 {
+		limit["context"] = e.Context
+	}
+	if out := e.PublishedOutput(); out > 0 {
+		limit["output"] = out
+	}
+	if len(limit) > 0 {
+		m["limit"] = limit
+	}
+	if e.Reasoning {
+		m["reasoning"] = true
+	}
+	if len(e.Efforts) > 0 {
+		m["support_efforts"] = e.Efforts
+		// kimi-code starts a model on default_effort, else the middle of
+		// support_efforts, else on; the registry's owner picks another
+		// level (max, say) through the environment, and it goes out only
+		// where the model takes it
+		if de := registryDefaultEffort(); slices.Contains(e.Efforts, de) {
+			m["default_effort"] = de
+		}
+	}
+	if in, out := e.Modalities(); in != nil || out != nil {
+		mod := map[string]any{}
+		if in != nil {
+			mod["input"] = in
+		}
+		if out != nil {
+			mod["output"] = out
+		}
+		m["modalities"] = mod
+	}
+	if pr, ok := price(e); ok {
+		m["cost"] = pr
+	}
+	return m
+}
diff --git a/internal/gateway/apijson_test.go b/internal/gateway/apijson_test.go
new file mode 100644
index 00000000..63ce394a
--- /dev/null
+++ b/internal/gateway/apijson_test.go
@@ -0,0 +1,203 @@
+package gateway
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/yetone/magpie/internal/catalog"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// GET /api.json is the gateway as a models.dev-shaped registry (kimi-code's
+// /provider paste): a model appears under a protocol bucket only where the
+// gateway passes it through untranslated, its id keeps magpie's
+// provider/model form, a window it doesn't know is left out for the
+// importer's own default, and the routing groups sit under their own bucket
+// by bare id. The buckets' union is the model list's native subset — the
+// parity the registry owes /v1/models.
+func TestAPIJSONServesNativeBuckets(t *testing.T) {
+	f := &fake{ctype: "application/json", reply: `{"id":"x","object":"chat.completion","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}]}`}
+	up := setup(t, provider.Chat, f)
+	if err := provider.Save(provider.Provider{ID: "gx", Name: "GX", Key: "k",
+		Chat: up.URL + "/v1", Anthropic: up.URL,
+		Models: []string{"m-any", "m-chat", "m-res"}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := catalog.SaveLive("gx", up.URL+"/v1", []catalog.Model{
+		{ID: "m-any", Name: "Model Any", Context: 128000, Output: 4096, Efforts: []string{"low", "high"}},
+		{ID: "m-chat", Context: 64000, APIs: []string{"chat"}},
+		{ID: "m-res", APIs: []string{"responses"}}, // the vendor's only API this provider doesn't speak: no bucket
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := provider.SaveGroup(provider.Group{ID: "daily", Name: "Daily", Members: []string{"gx/m-any"}}); err != nil {
+		t.Fatal(err)
+	}
+
+	req := httptest.NewRequest("GET", "/api.json", nil)
+	rec := httptest.NewRecorder()
+	New().Handler().ServeHTTP(rec, req)
+	if rec.Code != 200 {
+		t.Fatalf("/api.json: %d %s", rec.Code, rec.Body)
+	}
+	var out map[string]struct {
+		Type   string                    `json:"type"`
+		API    string                    `json:"api"`
+		Models map[string]map[string]any `json:"models"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &out); err != nil {
+		t.Fatal(err)
+	}
+	if len(out) != 4 {
+		t.Fatalf("buckets: %v", out)
+	}
+	for id, want := range map[string]string{
+		"magpie-openai":           "openai",
+		"magpie-anthropic":        "anthropic",
+		"magpie-openai-responses": "openai_responses",
+		"magpie-group":            "openai",
+	} {
+		if out[id].Type != want {
+			t.Errorf("%s: type %q, want %q", id, out[id].Type, want)
+		}
+		if base := out[id].API; !strings.HasPrefix(base, "http://") {
+			t.Errorf("%s: api %q not off the request's host", id, base)
+		}
+	}
+	openai, anthropic, responses, group := out["magpie-openai"].Models, out["magpie-anthropic"].Models, out["magpie-openai-responses"].Models, out["magpie-group"].Models
+	if len(responses) != 0 {
+		t.Errorf("responses bucket serves %v; want none", responses)
+	}
+	if _, ok := openai["gx/m-any"]; !ok {
+		t.Errorf("openai bucket lacks gx/m-any: %v", openai)
+	}
+	if _, ok := anthropic["gx/m-any"]; !ok {
+		t.Errorf("anthropic bucket lacks gx/m-any: %v", anthropic)
+	}
+	if _, ok := openai["gx/m-chat"]; !ok {
+		t.Errorf("openai bucket lacks gx/m-chat: %v", openai)
+	}
+	if _, ok := anthropic["gx/m-chat"]; ok {
+		t.Errorf("anthropic bucket serves gx/m-chat, native on chat alone: %v", anthropic)
+	}
+	for _, b := range []map[string]map[string]any{openai, anthropic, responses} {
+		if _, ok := b["gx/m-res"]; ok {
+			t.Errorf("a bucket serves gx/m-res, native on nothing it speaks: %v", b)
+		}
+	}
+	if _, ok := group["daily"]; !ok {
+		t.Errorf("group bucket lacks the bare id daily: %v", group)
+	}
+	if _, ok := group["group/daily"]; ok {
+		t.Errorf("group bucket carries the prefixed id group/daily: %v", group)
+	}
+	// the group's efforts come from the catalog's own computation over the
+	// members (the one member's levels here), like its limits do; its name
+	// is the agent-list label, "· routing group" after it
+	if m := group["daily"]; m["support_efforts"] == nil {
+		t.Errorf("group daily carries no support_efforts: %v", m)
+	} else if got, ok := m["support_efforts"].([]any); !ok || len(got) != 2 || got[0] != "low" || got[1] != "high" {
+		t.Errorf("group daily: support_efforts %v, want [low high]", m["support_efforts"])
+	} else if m["id"] != "daily" {
+		t.Errorf("group daily: id %v, want the bare id its key has", m["id"])
+	} else if m["name"] != "Daily · routing group" {
+		t.Errorf("group daily: name %v, want the labelled one", m["name"])
+	}
+	if m := openai["gx/m-any"]; m != nil && m["name"] != "Model Any · GX" {
+		t.Errorf("gx/m-any: name %v, want the labelled one", m["name"])
+	}
+	if m := openai["gx/m-chat"]; m != nil {
+		if m["name"] != "m-chat · GX" {
+			t.Errorf("gx/m-chat: name %v, want the labelled one", m["name"])
+		}
+	}
+	if m := openai["gx/m-any"]; m == nil {
+		// covered above
+	} else {
+		if m["tool_call"] != true {
+			t.Errorf("gx/m-any: tool_call %v", m["tool_call"])
+		}
+		limit, ok := m["limit"].(map[string]any)
+		if !ok || limit["context"] != float64(128000) || limit["output"] != float64(4096) {
+			t.Errorf("gx/m-any: limit %v", m["limit"])
+		}
+	}
+	if m := openai["gx/m-chat"]; m != nil {
+		limit, ok := m["limit"].(map[string]any)
+		if !ok || limit["context"] != float64(64000) {
+			t.Errorf("gx/m-chat: limit %v; want its known context alone", m["limit"])
+		} else if _, has := limit["output"]; has {
+			t.Errorf("gx/m-chat: limit %v carries an output it doesn't know", limit)
+		}
+	}
+}
+
+// GET /api.json answers MAGPIE_REGISTRY_DEFAULT_EFFORT by offering that
+// thinking level as every able model's default_effort — the level a client
+// like kimi-code starts a model on instead of the middle of its levels —
+// on every bucket, and none on a model that doesn't take it.
+func TestAPIJSONDefaultEffort(t *testing.T) {
+	t.Setenv("MAGPIE_REGISTRY_DEFAULT_EFFORT", "max")
+	f := &fake{ctype: "application/json", reply: `{"id":"x","object":"chat.completion","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}]}`}
+	up := setup(t, provider.Chat, f)
+	if err := provider.Save(provider.Provider{ID: "gx", Name: "GX", Key: "k",
+		Chat: up.URL + "/v1", Anthropic: up.URL,
+		Models: []string{"m-max", "m-nomax"}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := catalog.SaveLive("gx", up.URL+"/v1", []catalog.Model{
+		{ID: "m-max", Name: "Model Max", Efforts: []string{"low", "high", "max"}},
+		{ID: "m-nomax", Name: "Model NoMax", Efforts: []string{"low", "high"}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest("GET", "/api.json", nil)
+	rec := httptest.NewRecorder()
+	New().Handler().ServeHTTP(rec, req)
+	var out map[string]struct {
+		Models map[string]map[string]any `json:"models"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &out); err != nil {
+		t.Fatal(err)
+	}
+	if m := out["magpie-openai"].Models["gx/m-max"]; m["default_effort"] != "max" {
+		t.Errorf("gx/m-max: default_effort %v, want max", m["default_effort"])
+	}
+	if m := out["magpie-anthropic"].Models["gx/m-max"]; m["default_effort"] != "max" {
+		t.Errorf("anthropic bucket gx/m-max: default_effort %v, want max", m["default_effort"])
+	}
+	if m := out["magpie-openai"].Models["gx/m-nomax"]; m["default_effort"] != nil {
+		t.Errorf("gx/m-nomax: default_effort %v; it takes no max", m["default_effort"])
+	}
+}
+
+// GET /api.json says no default_effort while the environment is silent:
+// the client's own default (the middle of a model's levels) stands.
+func TestAPIJSONNoDefaultEffortWithoutEnv(t *testing.T) {
+	f := &fake{ctype: "application/json", reply: `{"id":"x","object":"chat.completion","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}]}`}
+	up := setup(t, provider.Chat, f)
+	if err := provider.Save(provider.Provider{ID: "gx", Name: "GX", Key: "k",
+		Chat: up.URL + "/v1", Anthropic: up.URL,
+		Models: []string{"m-max"}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := catalog.SaveLive("gx", up.URL+"/v1", []catalog.Model{
+		{ID: "m-max", Name: "Model Max", Efforts: []string{"low", "high", "max"}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	req := httptest.NewRequest("GET", "/api.json", nil)
+	rec := httptest.NewRecorder()
+	New().Handler().ServeHTTP(rec, req)
+	var out map[string]struct {
+		Models map[string]map[string]any `json:"models"`
+	}
+	if err := json.Unmarshal(rec.Body.Bytes(), &out); err != nil {
+		t.Fatal(err)
+	}
+	if m := out["magpie-openai"].Models["gx/m-max"]; m["default_effort"] != nil {
+		t.Errorf("gx/m-max: default_effort %v with the environment unset", m["default_effort"])
+	}
+}
