+		t.Fatal(err)
+	}
+	delete(was["thinking"].(map[string]any), "effort")
+	if err := a.Disconnect(); err != nil {
+		t.Fatal(err)
+	}
+	if now := readKimiTOML(t, path); !reflect.DeepEqual(now, was) {
