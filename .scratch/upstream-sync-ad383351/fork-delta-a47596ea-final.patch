diff --git a/internal/gateway/search_pass.go b/internal/gateway/search_pass.go
new file mode 100644
index 00000000..35ea0d5d
--- /dev/null
+++ b/internal/gateway/search_pass.go
@@ -0,0 +1,188 @@
+package gateway
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// A keyed Remote magpie searches the web through the web-search MCP server
+// of its own (SearchMCPPath on the remote): one JSON-RPC tools/call for
+// web_search with the query, the provider's key as the gateway key. The
+// remote's whole chain — its searcher, its Search APIs, its services —
+// answers, and its answer text is the local search result with no pages of
+// its own: no Sources list is added. Every pass-through carries the
+// searching mark (SearchingHeader) with magpie's User-Agent, so the remote
+// runs no searcher of its own for it — and a search another magpie sent
+// here (searchFromMagpie) is never forwarded to a keyed remote service,
+// so two magpies that name each other's services cannot loop. Like a Kimi
+// Code plan's and DeepSeek's keyed services (search_service.go) the
+// remote's web search is a manual-only choice with no model, beside the
+// remote's natively-searching models, which keep working as searchers as
+// they do today. A transport failure or a timeout is a failed source like
+// any searcher's; a remote tool error surfaces the text the remote wrote.
+// A successful call records a zero-cost row: the spend is the remote's,
+// on its own usage. The same server answers the fetch pass-through: a
+// keyed Remote magpie named under "Fetch pages with" has the url,
+// max_chars and offset forwarded to its web_fetch (fetchByMagpie below).
+
+// magpieSearchRead is how much of a reply the pass-through reads: the
+// remote's answer is one tool result, and 4 MiB is past any of them. A
+// reply cut by it is no JSON any more, and fails as an unexpected reply.
+const magpieSearchRead = 4 << 20
+
+// magpieFetchTimeout is how long the remote's web_fetch has to answer —
+// the web fetch's own 30 seconds, after which magpie's own downloader
+// reads. A var so a test can shrink it.
+var magpieFetchTimeout = webFetchTimeout
+
+// remoteMagpieService is where p's key searches through its own web-search
+// MCP server, "" for a provider that isn't a keyed remote magpie: the
+// remote's base — its Chat base carries /v1 — with SearchMCPPath.
+func remoteMagpieService(p provider.Provider) string {
+	if p.Account != nil || !p.IsRemoteMagpie() || p.Key == "" || p.Chat == "" {
+		return ""
+	}
+	return strings.TrimSuffix(strings.TrimRight(p.Chat, "/"), "/v1") + SearchMCPPath
+}
+
+// remoteMagpieSearch asks p's web_search on the remote: its answer text,
+// with no pages — the remote's chain wrote it. The mark rides the request
+// whoever the search is for, and a search another magpie sent here is not
+// forwarded again.
+func (s *Server) remoteMagpieSearch(ctx context.Context, p provider.Provider, query string) (string, []Hit, error) {
+	if searchFromMagpie(ctx) {
+		return "", nil, fmt.Errorf("%s: a search another magpie made is not forwarded to a searcher of its own", p.Name)
+	}
+	q, err := maskedQuery(ctx, query, &p)
+	if err != nil {
+		return "", nil, err
+	}
+	text, err := s.magpieMCPCall(ctx, p, remoteMagpieService(p), p.Key, searchMCPTool, map[string]any{"query": q})
+	if err != nil {
+		return "", nil, err
+	}
+	if text == "" {
+		return "", nil, fmt.Errorf("%s %w", p.Name, errFoundNothing)
+	}
+	s.recordServiceSearch(ctx, p, p.Key, "web_search_api", nil)
+	return text, nil, nil
+}
+
+// magpieMCPCall asks the web-search MCP server at at — p's, with its key —
+// one JSON-RPC tools/call for tool with args, and says the text its result
+// carried. A remote tool error is the error, carrying the remote's text; a
+// transport failure, an HTTP error or a JSON-RPC error is the error alone,
+// which the caller treats as any failure of its own — the search falls
+// through, and the fetch pass-through falls back on magpie's own
+// downloader for the transport failures, the timeouts, and an HTTP 429 or
+// 5xx (fetchTransient) and surfaces the rest.
+func (s *Server) magpieMCPCall(ctx context.Context, p provider.Provider, at, key, tool string, args map[string]any) (string, error) {
+	ctx, cancel := context.WithTimeout(s.metered(p.Via(ctx), p, ""), searchTimeout)
+	defer cancel()
+	body, _ := json.Marshal(map[string]any{
+		"jsonrpc": "2.0", "id": 1, "method": "tools/call",
+		"params": map[string]any{"name": tool, "arguments": args},
+	})
+	r, err := http.NewRequestWithContext(ctx, http.MethodPost, at, bytes.NewReader(body))
+	if err != nil {
+		return "", err
+	}
+	r.Header.Set("Content-Type", "application/json")
+	r.Header.Set("Accept", "application/json")
+	r.Header.Set("User-Agent", magpieUA())
+	r.Header.Set("Authorization", "Bearer "+key)
+	// the remote runs no searcher of its own for a marked search, so two
+	// magpies that name each other's services cannot loop (search_remote.go)
+	r.Header.Set(SearchingHeader, "1")
+	res, err := s.client.Do(r)
+	if err != nil {
+		if ctx.Err() != nil {
+			return "", fetchTransient{fmt.Errorf("%s: no answer in time", p.Name)}
+		}
+		return "", fetchTransient{fmt.Errorf("%s: %w", p.Name, err)}
+	}
+	defer res.Body.Close()
+	b, _ := io.ReadAll(io.LimitReader(res.Body, magpieSearchRead))
+	head := b[:min(len(b), 1<<20)]
+	if res.StatusCode >= 300 {
+		// an error that says the key back doesn't get it into magpie's logs
+		msg := strings.ReplaceAll(provider.APIError(head, res.Status), key, provider.MaskSearchKey(key))
+		if res.StatusCode == 429 || res.StatusCode >= 500 {
+			// a remote that is busy or failing says nothing about the page:
+			// the fetch pass-through falls back on magpie's own downloader
+			return "", fetchTransient{errors.New(p.Name + ": " + msg)}
+		}
+		return "", errors.New(p.Name + ": " + msg)
+	}
+	var out struct {
+		Result struct {
+			Content []struct {
+				Type string `json:"type"`
+				Text string `json:"text"`
+			} `json:"content"`
+			IsError bool `json:"isError"`
+		} `json:"result"`
+		Error *struct {
+			Message string `json:"message"`
+		} `json:"error"`
+	}
+	if err := json.Unmarshal(b, &out); err != nil {
+		return "", fmt.Errorf("%s: unexpected reply: %s", p.Name, provider.APIError(head, res.Status))
+	}
+	if out.Error != nil {
+		return "", fmt.Errorf("%s: %s", p.Name, out.Error.Message)
+	}
+	text := ""
+	for _, c := range out.Result.Content {
+		if c.Type == "text" {
+			text = c.Text
+			break
+		}
+	}
+	if out.Result.IsError {
+		if text == "" {
+			return "", fmt.Errorf("%s: the tool failed there", p.Name)
+		}
+		return "", errors.New(text)
+	}
+	return text, nil
+}
+
+// fetchByMagpie reads the page through a keyed Remote magpie's web_fetch:
+// the url, max_chars and offset the tool received forwarded whole — the
+// remote applies them on the page it reads, its own downloader guarding its
+// own addresses — and its answer text comes back as-is, parts and all. A
+// transport failure, the timeout (magpieFetchTimeout), or the remote
+// answering an HTTP 429 or 5xx hands the page to magpie's own downloader,
+// both failing said together; the remote's own error — its tool error, any
+// other HTTP error, a JSON-RPC error — surfaces with no fallback: it is
+// the remote's word on the page or the key. A successful pass-through
+// records the zero-cost row.
+func (s *Server) fetchByMagpie(ctx context.Context, p provider.Provider, u *url.URL, a fetchArgs, limit int) (string, error) {
+	rctx, cancel := context.WithTimeout(ctx, magpieFetchTimeout)
+	defer cancel()
+	text, err := s.magpieMCPCall(rctx, p, remoteMagpieService(p), p.Key, fetchMCPTool,
+		map[string]any{"url": strings.TrimSpace(a.URL), "max_chars": a.MaxChars, "offset": a.Offset})
+	if err == nil {
+		s.recordServiceSearch(ctx, p, p.Key, "web_fetch", nil)
+		return text, nil
+	}
+	var transient fetchTransient
+	if !errors.As(err, &transient) {
+		return "", searchMCPError(err.Error())
+	}
+	said, ferr := s.fetchOwn(ctx, u, a.Offset, limit)
+	if ferr != nil {
+		return "", searchMCPError("couldn't fetch " + u.Redacted() + ": " + err.Error() + "; " + ferr.Error())
+	}
+	return said, nil
+}
diff --git a/internal/gateway/search_pass_test.go b/internal/gateway/search_pass_test.go
new file mode 100644
index 00000000..b5bb82a4
--- /dev/null
+++ b/internal/gateway/search_pass_test.go
@@ -0,0 +1,702 @@
+package gateway
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/catalog"
+	"github.com/yetone/magpie/internal/provider"
+	"github.com/yetone/magpie/internal/settings"
+	"github.com/yetone/magpie/internal/usage"
+)
+
+// remoteMagpieSite is a fake of another magpie: /v1/models lists a model it
+// searches for itself (web_search "native"), /v1/messages answers a
+// passed-through web_search as its vendor does, and /mcp/magpie/web-search
+// answers the JSON-RPC tools/call its web_search MCP server serves
+// (search_mcp.go's reply shape). Everything it was asked is recorded under
+// a lock: the handler runs on many goroutines.
+type remoteMagpieSite struct {
+	*httptest.Server
+	mu    sync.Mutex
+	asked []string // "method path | auth | ua | mark | body"
+	mode  string   // "", "toolerr", "hang"
+	text  string   // the tool answer's text
+}
+
+func newRemoteMagpieSite(t *testing.T) *remoteMagpieSite {
+	s := &remoteMagpieSite{text: "Go 1.27.1 is out."}
+	s.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		s.mu.Lock()
+		s.asked = append(s.asked, strings.Join([]string{
+			r.Method + " " + r.URL.Path, r.Header.Get("Authorization"),
+			r.Header.Get("User-Agent"), r.Header.Get(SearchingHeader), string(b),
+		}, " | "))
+		mode, text := s.mode, s.text
+		s.mu.Unlock()
+		switch {
+		case r.Method == http.MethodGet && r.URL.Path == "/v1/models":
+			io.WriteString(w, `{"data":[{"id":"glm-5.3","web_search":"native"}]}`)
+		case r.Method == http.MethodPost && r.URL.Path == "/mcp/magpie/web-search":
+			switch mode {
+			case "toolerr":
+				io.WriteString(w, `{"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"`+text+`"}],"isError":true}}`)
+			case "hang":
+				select {
+				case <-time.After(30 * time.Second):
+				case <-r.Context().Done():
+				}
+			case "502":
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(http.StatusBadGateway)
+				io.WriteString(w, `{"error":{"message":"bad gateway"}}`)
+			case "429":
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(http.StatusTooManyRequests)
+				io.WriteString(w, `{"error":{"message":"slow down"}}`)
+			case "401":
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(http.StatusUnauthorized)
+				io.WriteString(w, `{"error":{"message":"the key is no good"}}`)
+			default:
+				io.WriteString(w, `{"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"`+text+`"}],"isError":false}}`)
+			}
+		case r.Method == http.MethodPost:
+			// its vendor searches for the model the request names
+			w.Header().Set("Content-Type", "application/json")
+			io.WriteString(w, `{"id":"m","type":"message","role":"assistant","model":"glm-5.3","content":[`+
+				`{"type":"server_tool_use","id":"s1","name":"web_search","input":{"query":"go"}},`+
+				`{"type":"web_search_tool_result","tool_use_id":"s1","content":[{"type":"web_search_result","title":"Go","url":"https://go.dev/"}]},`+
+				`{"type":"text","text":"Go 1.27.1 is out."}],"stop_reason":"end_turn","usage":{"input_tokens":3,"output_tokens":4}}`)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(s.Close)
+	return s
+}
+
+func (s *remoteMagpieSite) set(mode, text string) {
+	s.mu.Lock()
+	s.mode, s.text = mode, text
+	s.mu.Unlock()
+}
+
+func (s *remoteMagpieSite) log() []string {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return slices.Clone(s.asked)
+}
+
+// saveRemoteMagpie saves a keyed remote magpie on the site.
+func saveRemoteMagpie(t *testing.T, id string, s *remoteMagpieSite) provider.Provider {
+	t.Helper()
+	if err := provider.Save(provider.Provider{ID: id, Name: "Office", Preset: provider.RemoteMagpiePreset,
+		Chat: strings.TrimPrefix(s.URL, "http://"), Key: "sk-" + id, KeyName: "Main"}); err != nil {
+		t.Fatal(err)
+	}
+	p, err := provider.Find(id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return *p
+}
+
+// nameRemoteMagpieService saves a keyed remote magpie on the fake and names
+// its web search in Settings, as a user who picked it in the Web search
+// section has it.
+func nameRemoteMagpieService(t *testing.T, s *remoteMagpieSite) {
+	t.Helper()
+	saveRemoteMagpie(t, "office", s)
+	st := settings.Load()
+	st.Searcher = "office"
+	if err := settings.Save(st); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// Naming a keyed remote magpie's service asks the web-search MCP server on
+// the remote — one JSON-RPC tools/call for web_search, the masked query,
+// the provider's key — and its answer text is the tool result whole: no
+// Sources list is added, and no model of the remote is asked.
+func TestRemoteMagpieServiceSearches(t *testing.T) {
+	searchSandbox(t)
+	s := newRemoteMagpieSite(t)
+	nameRemoteMagpieService(t, s)
+
+	// the settings JSON offers the remote's web search: a service choice,
+	// manual-only, with no model
+	var choice *SearcherChoice
+	cs := Searchers()
+	for i := range cs {
+		if cs[i].Provider.ID == "office" {
+			choice = &cs[i]
+		}
+	}
+	if choice == nil || !choice.Service || !choice.ManualOnly || choice.Small != "" || len(choice.Models) != 0 {
+		t.Fatalf("the remote's service entry is missing: %+v", cs)
+	}
+	if cp, model, why := chosenSearcher(); cp == nil || cp.ID != "office" || model != "" || why != "" {
+		t.Fatalf("named %v %q %q", cp, model, why)
+	}
+
+	call := readMCP(t, mcpPost(lanGuard(New().Handler()), "127.0.0.1:50000", mcpSearchCall, "User-Agent", "Cursor/1.7"))
+	if call.Result.IsError || len(call.Result.Content) != 1 || call.Result.Content[0].Text != "Go 1.27.1 is out." {
+		t.Fatalf("tools/call: %+v", call)
+	}
+	if strings.Contains(call.Result.Content[0].Text, "Sources:") {
+		t.Fatal("the pass-through added a Sources list")
+	}
+	asked := s.log()
+	if len(asked) != 1 || !strings.HasPrefix(asked[0], "POST /mcp/magpie/web-search | Bearer sk-office | ") {
+		t.Fatalf("the remote magpie was asked %q", asked)
+	}
+	var msg struct {
+		JSONRPC string          `json:"jsonrpc"`
+		ID      json.RawMessage `json:"id"`
+		Method  string          `json:"method"`
+		Params  struct {
+			Name      string `json:"name"`
+			Arguments struct {
+				Query string `json:"query"`
+			} `json:"arguments"`
+		} `json:"params"`
+	}
+	if err := json.Unmarshal([]byte(asked[0][strings.LastIndex(asked[0], "| ")+2:]), &msg); err != nil {
+		t.Fatalf("the body wasn't JSON-RPC: %v", err)
+	}
+	if msg.JSONRPC != "2.0" || string(msg.ID) != "1" || msg.Method != "tools/call" ||
+		msg.Params.Name != "web_search" || msg.Params.Arguments.Query != "latest go" {
+		t.Fatalf("the tools/call was %s %s %s %s %q", msg.JSONRPC, msg.ID, msg.Method, msg.Params.Name, msg.Params.Arguments.Query)
+	}
+}
+
+// The pass-through carries the searching mark, so the remote would never
+// forward that search to another magpie's searcher: a search another magpie
+// sent here (SearchingHeader, a magpie User-Agent) is answered, but its
+// named remote service is not asked, while this magpie's own search is.
+func TestRemoteMagpieSearchMarksCall(t *testing.T) {
+	searchSandbox(t)
+	s := newRemoteMagpieSite(t)
+	nameRemoteMagpieService(t, s)
+	h := lanGuard(New().Handler())
+
+	call := readMCP(t, mcpPost(h, "127.0.0.1:50000", mcpSearchCall, "User-Agent", "Cursor/1.7"))
+	if call.Result.IsError {
+		t.Fatalf("tools/call: %+v", call)
+	}
+	asked := s.log()
+	if len(asked) != 1 {
+		t.Fatalf("the remote magpie was asked %q", asked)
+	}
+	parts := strings.SplitN(asked[0], " | ", 5)
+	if parts[3] != "1" || !strings.HasPrefix(parts[2], "magpie/") {
+		t.Fatalf("the pass-through carried ua %q, mark %q", parts[2], parts[3])
+	}
+
+	// the same magpie, keyed and named, answering a search another magpie
+	// sent here: it is not forwarded to the searcher of its own
+	other := newRemoteMagpieSite(t)
+	saveRemoteMagpie(t, "other", other)
+	st := settings.Load()
+	st.Searcher = "other"
+	if err := settings.Save(st); err != nil {
+		t.Fatal(err)
+	}
+	m := readMCP(t, mcpPost(h, "127.0.0.1:50000", mcpSearchCall, "User-Agent", "magpie/0.1.999", SearchingHeader, "1"))
+	if !m.Result.IsError {
+		t.Fatal("a search another magpie made was answered by a searcher of its own")
+	}
+	if n := len(other.log()); n != 0 {
+		t.Fatalf("the marked search was forwarded: %q", other.log())
+	}
+	if m := readMCP(t, mcpPost(h, "127.0.0.1:50000", mcpSearchCall, "User-Agent", "Cursor/1.7")); m.Result.IsError {
+		t.Fatalf("this magpie's own search: %+v", m)
+	}
+	if n := len(other.log()); n != 1 {
+		t.Fatalf("this magpie's own search asked the other magpie %d times", n)
+	}
+}
