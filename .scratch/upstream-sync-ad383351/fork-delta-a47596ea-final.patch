+func TestKimiThinkingEffortStoppedWSL(t *testing.T) {
+	keptEffortHome(t)
+	d := distro{Name: "Stopped", Root: t.TempDir(), Home: "/home/me", Running: false}
+	a := wslAgent(wslKindOf("kimi"), d)
+	if a.Field("effort") != nil {
