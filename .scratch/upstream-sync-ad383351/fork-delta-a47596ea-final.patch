+	if FetchUnused() != SearcherGone {
+		t.Fatalf("gone: unused %q", FetchUnused())
+	}
+	if got := read(); !strings.Contains(got, fetchOwnSaid) || len(s.log()) != asked {
+		t.Fatalf("gone: %q %q", got, s.log())
+	}
