+		t.Fatal(err)
+	}
+	check("xhigh")
+	if err := a.Pick("model", "magpie/think/wide"); err != nil {
+		t.Fatal(err)
+	}
+	check("xhigh")
+	if err := a.Apply("thinking", "max"); err != nil {
+		t.Fatal(err)
+	}
+	was["thinking"].(map[string]any)["effort"] = "max"
+	if err := a.Sync(); err != nil {
+		t.Fatal(err)
+	}
+	check("max")
+}
